# Docker build context exclusions for example-app.

# Build output (rebuilt inside the image).
target/

# Version control.
.git/
.gitignore

# Local environment and secrets — never baked into an image.
.env
*.env.local

# Local SQLite runtime databases.
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Runtime storage junk (logs, caches, uploaded files).
storage/logs/*
storage/framework/*
storage/app/*
!storage/**/.gitignore

# Editor / OS noise.
.idea/
.vscode/
*.swp
.DS_Store

# Compose files describe the surrounding stack, not the app image.
docker-compose*.yml
